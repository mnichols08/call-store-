# Copy to .env or set these on the host. Everything has a development default except SESSION_SECRET in production.
NODE_ENV=production
PORT=3000
DATABASE_PATH=/data/call-store.db      # a persistent volume
SESSION_SECRET=                        # 32+ random characters
BUSINESS_NAME=Southern Auto Supply
TIME_ZONE=America/New_York
TRUSTED_PROXIES=1                      # proxies in front adding X-Forwarded-For (Railway: 1)
PUBLIC_URL=https://calls.example.com   # used to print the first owner's setup link
