# Copy to .env or set these on the host. Everything has a development default except SESSION_SECRET in production.
NODE_ENV=production
PORT=3000
DATABASE_PATH=/data/call-store.db      # a persistent volume
SESSION_SECRET=                        # 32+ random characters
BUSINESS_NAME=Southern Auto Supply
TIME_ZONE=America/New_York
TRUSTED_PROXIES=1                      # proxies in front adding X-Forwarded-For (Railway: 1)
PUBLIC_URL=https://calls.example.com   # used to print the first owner's setup link
PICKUP_TARGET_MINUTES=5                # reports show how often callers are picked up within this
LOG_REQUESTS=true                      # one JSON line per request
METRICS_TOKEN=                         # set to expose /metrics (Prometheus) to a scraper
# VAPID_PUBLIC_KEY=                    # Web Push identity; generated and kept in the database if unset
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Part finder. Without a key it still works from the answers the shop has saved.
# ANTHROPIC_API_KEY=                   # your Claude key; stays on the server
# AI_MODEL=claude-haiku-5-5
# AI_WEB_SEARCH=true                   # lets it check catalogue pages (turn on web search in the Anthropic Console first)
# AI_SEARCH_DOMAINS=                   # optional: comma-separated sites it may search, e.g. napaonline.com,dormanproducts.com
# AI_HOURLY_LIMIT=30                   # AI lookups per hour, whole shop
# AI_DAILY_LIMIT=200
